{
    "name": "me-portfolio",
    "version": "0.1.0",
    "private": false,
    "description": "This is my portfolio that showcases my work experience as a Full-stack Software Engineer. Built it with Nextjs, TailwindCSS, Aceternity UI, and Framer Motion.",
    "main": "index.js",
    "repository": "git@github.com:coolbeatz71/next-portfolio.git",
    "author": "coolbeatz71 <sigmacool@gmail.com>",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "next dev -p 8070",
        "build": "next build",
        "start": "next start",
        "type:check": "tsc",
        "lint:code": "biome lint --no-errors-on-unmatched ./src",
        "lint:code:fix": "biome check --write ./src",
        "lint:types": "tsc --noEmit",
        "analyze": "cross-env ANALYZE=true next build",
        "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
        "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
        "dev:scan": "next dev & npx react-scan@latest localhost:3000",
        "prepare": "husky"
    },
    "dependencies": {
        "@biomejs/biome": "^2.4.2",
        "@emailjs/browser": "^4.4.1",
        "@hookform/resolvers": "^5.2.2",
        "@types/numeral": "^2.0.5",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.13",
        "i18next": "^25.8.11",
        "motion": "^12.34.2",
        "next": "^14.2.8",
        "next-themes": "^0.4.4",
        "numeral": "^2.0.6",
        "react": "^19.2.4",
        "react-countup": "^6.5.3",
        "react-dom": "^19.2.4",
        "react-hook-form": "^7.54.2",
        "react-hot-toast": "^2.5.1",
        "react-i18next": "^15.0.1",
        "react-icons": "^5.3.0",
        "react-intersection-observer": "^10.0.3",
        "react-scan": "^0.5.3",
        "react-use": "^17.5.1",
        "tailwind-merge": "^3.5.0",
        "yup": "^1.6.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.2.0",
        "@types/node": "^25.2.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "enforce-branch-name": "^1.1.2",
        "husky": "^9.1.5",
        "lint-staged": "^16.2.7",
        "postcss": "^8",
        "tailwind-scrollbar": "^4.0.2",
        "tailwindcss": "^4.2.0",
        "typescript": "^5"
    }
}
