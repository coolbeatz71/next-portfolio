{
    "name": "me-portfolio",
    "version": "0.1.0",
    "description": "This is my portfolio that showcases my work experience as a Full-stack Software Engineer. Built it with Nextjs, TailwindCSS, Aceternity UI, and Framer Motion.",
    "main": "index.js",
    "repository": "git@github.com:coolbeatz71/next-portfolio.git",
    "author": "coolbeatz71 <sigmacool@gmail.com>",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "next dev -p 8070",
        "build": "next build",
        "start": "next start",
        "type:check": "tsc",
        "lint:code": "biome lint --no-errors-on-unmatched ./src",
        "lint:code:fix": "biome check --write ./src",
        "lint:types": "tsc --noEmit",
        "analyze": "cross-env ANALYZE=true next build",
        "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
        "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
        "prepare": "husky"
    },
    "dependencies": {
        "@biomejs/biome": "^2.4.4",
        "@emailjs/browser": "^4.4.1",
        "@hookform/resolvers": "^5.2.2",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.19",
        "i18next": "^26.4.2",
        "motion": "^14.0.0",
        "next": "^16.3.8",
        "next-themes": "^0.4.6",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-hook-form": "^7.71.2",
        "react-hot-toast": "^2.6.0",
        "react-i18next": "^17.0.15",
        "react-icons": "^5.5.0",
        "react-intersection-observer": "^11.0.1",
        "react-scan": "^0.5.3",
        "react-use": "^17.6.0",
        "sharp": "^0.35.5",
        "tailwind-merge": "^3.5.0",
        "yup": "^1.7.1"
    },
    "browserslist": [
        "Chrome >= 109",
        "Firefox >= 110",
        "Safari >= 16.4",
        "Edge >= 109"
    ],
    "devDependencies": {
        "@next/bundle-analyzer": "^16.1.6",
        "@tailwindcss/postcss": "^4.2.0",
        "@types/node": "^26.6.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "cross-env": "^10.1.0",
        "enforce-branch-name": "^1.1.2",
        "husky": "^9.1.5",
        "lint-staged": "^17.6.0",
        "postcss": "^8",
        "tailwind-scrollbar": "^4.0.2",
        "tailwindcss": "^4.2.0",
        "typescript": "^7.0.2"
    }
}
