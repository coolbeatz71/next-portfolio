{
    "name": "me-portfolio",
    "version": "0.1.0",
    "private": false,
    "description": "This is my portfolio that showcases my work experience as a Full-stack Software Engineer. Built it with Nextjs, TailwindCSS, Aceternity UI, and Framer Motion.",
    "main": "index.js",
    "repository": "git@github.com:coolbeatz71/next-portfolio.git",
    "author": "coolbeatz71 <sigmacool@gmail.com>",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "next dev -p 8070",
        "build": "next build",
        "start": "next start",
        "type:check": "tsc",
        "lint:code": "biome lint --no-errors-on-unmatched ./src",
        "lint:code:fix": "biome check --write ./src",
        "lint:types": "tsc --noEmit",
        "analyze": "cross-env ANALYZE=true next build",
        "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
        "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
        "prepare": "husky"
    },
    "dependencies": {
        "@biomejs/biome": "^1.9.0",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.13",
        "framer-motion": "^11.5.4",
        "i18next": "^23.14.0",
        "next": "^14.2.8",
        "next-themes": "^0.3.0",
        "nprogress": "^0.2.0",
        "react": "^18",
        "react-dom": "^18",
        "react-i18next": "^15.0.1",
        "react-icons": "^5.3.0",
        "sass": "^1.78.0",
        "tailwind-merge": "^2.5.2"
    },
    "devDependencies": {
        "@types/node": "^22.5.4",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "autoprefixer": "^10.0.1",
        "enforce-branch-name": "^1.1.2",
        "husky": "^9.1.5",
        "lint-staged": "^15.2.10",
        "postcss": "^8",
        "tailwindcss": "^3.4.10",
        "typescript": "^5"
    }
}
